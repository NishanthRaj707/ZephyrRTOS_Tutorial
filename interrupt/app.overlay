/{
    aliases{
        button=&sw;
        led=&ld;
    };

    leds{
        compatible="gpio-leds";
        ld:led_0{
            gpios=<&gpio0 2 GPIO_ACTIVE_HIGH>;
            label="status led"
        };
    };

    buttons{
        compatible="gpio-keys";
        sw:button_0{
            gpios=<&gpio0 6 (GPIO_PULL_UP|GPIO_ACTIVE_LOW)>;
            label="Control Button";
        };
    };
    
};